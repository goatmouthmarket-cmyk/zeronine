# Server (8010 to avoid clashing with the v10snipe dev server on 8000)
PORT=8010
NODE_ENV=development

# Deriv endpoints / app
# Public market feed endpoint (ticks). Keep the default.
DERIV_PUBLIC_URL=wss://api.derivws.com/trading/v1/options/ws/public
# Private sessions use the OTP socket flow on api.derivws.com (no extra endpoint needed).
# Your Deriv application ID (https://deriv.com/oauth2/app-registration)
DERIV_APP_ID=1089

# Local quick-start Personal Access Token (demo recommended).
# Create one at https://app.deriv.com/account/api-token (demo account).
# Leave blank if using OAuth only.
DERIV_PAT=

# Deriv OAuth (public login). Registered app settings only.
DERIV_OAUTH_CLIENT_ID=
DERIV_OAUTH_CLIENT_SECRET=
DERIV_OAUTH_REDIRECT_URI=http://localhost:5173/auth/deriv/callback
# At least 32 random chars for session encryption.
SESSION_SECRET=change-me-to-a-long-random-string
# Set this in a public deployment to keep the connected Deriv account private.
# Visitors can still inspect live markets, global test results, and patterns.
DASHBOARD_ADMIN_TOKEN=

# Gold / cTrader (separate, demo-first module)
# These values only expose non-secret readiness diagnostics in the current
# build. OAuth tokens are never supplied here or stored in browser storage.
CTRADER_API_URL=https://openapi.ctrader.com
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost:8010/api/gold/oauth/callback
# A separate 32+ character secret used only to encrypt cTrader OAuth tokens.
GOLD_TOKEN_ENCRYPTION_KEY=
CTRADER_ACCOUNT_MODE=demo
GOLD_SYMBOL=XAUUSD
# Keep disabled until PostgreSQL ownership, OAuth persistence, a reviewed demo
# adapter, idempotency and broker reconciliation are operating.
GOLD_LIVE_ENABLED=0

# Legacy demo-account sweep. This is NOT a risk-free paper simulator: it uses
# real Deriv demo contracts. It is disabled by default and requires both values
# below to be set intentionally. Use a positive interval in milliseconds.
ENABLE_AUTO_DEMO_PAPER_SWEEPS=0
AUTO_PAPER_INTERVAL_MS=0

# Storage
DATA_DIR=./data

# Risk / strategy (UI-overridable)
BASE_STAKE=1
MAX_STAKE=25
MARTINGALE_STEPS=5
MAX_CONSECUTIVE_LOSSES=10
MIN_EDGE=0.01
MIN_RECOVERY_WIN_RATE=0.30
BARRIER_PREFERENCE=over1
# Restrict trading to these symbols; empty = all Over/Under-capable synthetic indices
ALLOWED_MARKETS=
# Restrict trading to these symbols; empty = all Over/Under-capable synthetic indices
