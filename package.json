{
  "name": "overunder",
  "version": "0.1.0",
  "private": true,
  "description": "Over/Under Digit Sniper — Deriv synthetic-indices bot with intelligent money recovery",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "web:dev": "vite web",
    "build:web": "vite build web",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p web",
    "test": "node --test \"tests/*.test.ts\"",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run typecheck:web && npm test && npm run build:web"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.1.0",
    "fastify": "^5.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "lightweight-charts": "^5.0.0",
    "preact": "^10.26.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
